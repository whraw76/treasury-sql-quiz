# Copy to .env. Never commit the filled-in file.
APP_ENV=development
SECRET_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the publishable key (or legacy anon key), NOT the service-role key.
SUPABASE_KEY=
# Copy the SESSION pooler host from Supabase's Connect dialog; use port 5432.
# Custom role usernames in the pooler are ROLE.PROJECT_REF.
QUERY_DATABASE_URL=postgresql://treasury_reader.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SAVE_DATABASE_URL=postgresql://treasury_writer.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
